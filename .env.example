APP_NAME=GoWeb
APP_PORT=10101
APP_DEBUG=false
APP_VERSION=v1.0.0
APP_TIMEOUT=5
APP_SHUTDOWN_TIMEOUT=10
APP_RATE_LIMIT=10.0
APP_RATE_LIMIT_DEADLINE=60

USE_BODY_DUMP_LOG=false
BODY_DUMP_LOG_ROTATION_COUNT=30

ALLOWED_ORIGINS=http://localhost:1000

BACKEND_BASE_URL=http://127.0.0.1:10001
BACKEND_APP_KEY=
BACKEND_TIMEOUT=10
BACKEND_MAX_RESPONSE_BYTES=2097152
BACKEND_MAX_IDLE_CONNS=100
BACKEND_MAX_CONNS_PER_HOST=100
BACKEND_RETRY_COUNT=2
